# Salin jadi .env, lalu isi. Jangan pernah di-commit.

POSTGRES_PASSWORD=

# Dua kunci ini dibikin pakai: go run ./cmd/hq genkey
# HQ_ENCRYPTION_KEY dipakai buat enkripsi credential. Kalau kunci ini hilang,
# semua secret yang tersimpan ikut hilang — tidak ada jalan pulih.
HQ_SESSION_KEY=
HQ_ENCRYPTION_KEY=

# Akun tunggal, cuma dipakai waktu database masih kosong.
HQ_OWNER_EMAIL=
HQ_OWNER_PASSWORD=

# Lokal tanpa https: false. Di server di belakang nginx: true.
HQ_SECURE_COOKIE=true
HQ_ADDR=:8080
HQ_SESSION_DAYS=30

# Dipakai waktu jalan langsung (tanpa compose).
# DATABASE_URL=postgres://hq:PASSWORD@127.0.0.1:5432/hq?sslmode=disable

# Notifikasi web push. Bikin sepasang pakai: go run ./cmd/hq vapid
# Kalau dikosongkan, notifikasi cuma dilaporkan tidak tersedia; sisanya jalan.
HQ_VAPID_PUBLIC=
HQ_VAPID_PRIVATE=
HQ_VAPID_SUBJECT=mailto:kamu@example.com

# Jam pengingat harian, waktu lokal container. Setel TZ juga kalau bukan UTC.
HQ_REMINDER_HOUR=7

# Jam cek kebiasaan, waktu lokal container. Sengaja beda dari jam pengingat:
# pagi-pagi belum ada yang dicentang, jadi notifnya bakal selalu sama.
HQ_HABIT_HOUR=20

# Jam daftar belanja, dipisah koma. Ini satu-satunya pengingat yang dikerjain
# jauh dari layar, jadi diulang pas masih mungkin mampir ke toko. Isian yang
# salah di satu jam bikin seluruh daftar balik ke bawaan, bukan cuma jam itu.
HQ_SUPPLY_HOURS=7,15,21

# Token yang dipakai monitor luar buat lapor ke POST /api/monitor/report.
# Dikosongkan berarti endpoint-nya mati, bukan terbuka.
HQ_MONITOR_TOKEN=

# Buat baca isi piring dari foto makanan. Dikosongkan berarti tombol "tebak
# dari foto" bilang belum diatur, dan fotonya nggak pernah keluar dari server.
# Sisa fitur makan tetap jalan, tinggal diisi manual.
HQ_VISION_KEY=
HQ_VISION_MODEL=claude-sonnet-5

# Token buat POST /api/mcp, pintu yang dipakai asisten buat baca isi HQ.
# Isinya string acak yang panjang. Semua tool di balik sini cuma baca, dan
# credential nggak diekspos sama sekali. Dikosongkan berarti mati, bukan
# terbuka dengan token yang gampang ditebak.
HQ_MCP_TOKEN=
