# Salin jadi .env, lalu isi. Jangan pernah di-commit.

POSTGRES_PASSWORD=

# Dua kunci ini dibikin pakai: go run ./cmd/hq genkey
# HQ_ENCRYPTION_KEY dipakai buat enkripsi credential. Kalau kunci ini hilang,
# semua secret yang tersimpan ikut hilang — tidak ada jalan pulih.
HQ_SESSION_KEY=
HQ_ENCRYPTION_KEY=

# Akun tunggal, cuma dipakai waktu database masih kosong.
HQ_OWNER_EMAIL=
HQ_OWNER_PASSWORD=

# Lokal tanpa https: false. Di server di belakang nginx: true.
HQ_SECURE_COOKIE=true
HQ_ADDR=:8080
HQ_SESSION_DAYS=30

# Dipakai waktu jalan langsung (tanpa compose).
# DATABASE_URL=postgres://hq:PASSWORD@127.0.0.1:5432/hq?sslmode=disable

# Notifikasi web push. Bikin sepasang pakai: go run ./cmd/hq vapid
# Kalau dikosongkan, notifikasi cuma dilaporkan tidak tersedia; sisanya jalan.
HQ_VAPID_PUBLIC=
HQ_VAPID_PRIVATE=
HQ_VAPID_SUBJECT=mailto:kamu@example.com

# Jam pengingat harian, waktu lokal container. Setel TZ juga kalau bukan UTC.
HQ_REMINDER_HOUR=7

# Token yang dipakai monitor luar buat lapor ke POST /api/monitor/report.
# Dikosongkan berarti endpoint-nya mati, bukan terbuka.
HQ_MONITOR_TOKEN=
